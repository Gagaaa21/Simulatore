{
  "name": "sirena-118",
  "private": true,
  "version": "1.0.0",
  "description": "Sirena 118 – simulatore di scenari di soccorso sanitario extraospedaliero per la formazione dei soccorritori",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:artifact": "tsc -b && vite build --mode artifact && node scripts/make-artifact.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "2.1.9"
  }
}
